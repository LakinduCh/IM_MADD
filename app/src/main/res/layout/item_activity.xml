<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp">

    <View
        android:id="@+id/view_line"
        android:layout_width="2dp"
        android:layout_height="0dp"
        android:background="@color/tripon_light_green"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="@id/iv_dot"
        app:layout_constraintEnd_toEndOf="@id/iv_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:src="@drawable/bg_splash_shape"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/tv_activity_time"
        app:tint="@color/tripon_green"
        android:contentDescription="Activity indicator" />

    <TextView
        android:id="@+id/tv_activity_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="09:00 AM"
        android:textColor="@color/tripon_green"
        android:textSize="12sp"
        android:textStyle="bold"
        app:layout_constraintStart_toEndOf="@id/iv_dot"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_activity_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:text="Visit Nine Arches Bridge"
        android:textColor="@color/tripon_text"
        android:textStyle="bold"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_activity"
        app:layout_constraintStart_toStartOf="@id/tv_activity_time"
        app:layout_constraintTop_toBottomOf="@id/tv_activity_time" />

    <TextView
        android:id="@+id/tv_activity_desc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginEnd="8dp"
        android:text="Take photos of the famous train bridge."
        android:textColor="@color/tripon_secondary_text"
        android:textSize="13sp"
        app:layout_constraintEnd_toStartOf="@id/btn_remove_activity"
        app:layout_constraintStart_toStartOf="@id/tv_activity_name"
        app:layout_constraintTop_toBottomOf="@id/tv_activity_name" />

    <ImageButton
        android:id="@+id/btn_remove_activity"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/tripon_secondary_text"
        android:contentDescription="Remove activity" />

</androidx.constraintlayout.widget.ConstraintLayout>
