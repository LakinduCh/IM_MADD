<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/tv_attraction_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Attraction Name"
            android:textColor="@color/tripon_green"
            android:textStyle="bold"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@id/btn_remove_attraction"/>

        <ImageButton
            android:id="@+id/btn_remove_attraction"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_delete"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:tint="@color/tripon_secondary_text"
            android:contentDescription="Remove attraction" />

        <TextView
            android:id="@+id/tv_attraction_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Detailed description of the place."
            android:textColor="@color/tripon_secondary_text"
            android:textSize="14sp"
            app:layout_constraintTop_toBottomOf="@id/tv_attraction_name" />

        <TextView
            android:id="@+id/tv_attraction_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Ella, Badulla"
            android:textColor="@color/tripon_text"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tv_attraction_desc"
            app:layout_constraintStart_toStartOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_map_attraction"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="0dp"
            android:text="View on Google Maps"
            android:textAllCaps="false"
            android:textColor="@color/tripon_green"
            android:textSize="13sp"
            app:icon="@drawable/ic_home"
            app:iconPadding="8dp"
            app:iconSize="16dp"
            app:iconTint="@color/tripon_green"
            app:layout_constraintTop_toBottomOf="@id/tv_attraction_location"
            app:layout_constraintStart_toStartOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
