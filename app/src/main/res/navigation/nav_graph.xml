<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.triponai.ui.splash.SplashFragment"
        android:label="Splash"
        tools:layout="@layout/fragment_splash">
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_splashFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/splashFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.triponai.ui.auth.LoginFragment"
        android:label="Login"
        tools:layout="@layout/fragment_login">
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.triponai.ui.auth.RegisterFragment"
        android:label="Register"
        tools:layout="@layout/fragment_register">
        <action
            android:id="@+id/action_registerFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.triponai.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home">
        <action
            android:id="@+id/action_homeFragment_to_tripTypeFragment"
            app:destination="@id/tripTypeFragment" />
        <action
            android:id="@+id/action_homeFragment_to_previousTripDetailFragment"
            app:destination="@id/previousTripDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripTypeFragment"
        android:name="com.example.triponai.ui.plan.TripTypeFragment"
        android:label="Trip Type"
        tools:layout="@layout/fragment_trip_type">
        <action
            android:id="@+id/action_tripTypeFragment_to_travelGroupFragment"
            app:destination="@id/travelGroupFragment" />
    </fragment>

    <fragment
        android:id="@+id/travelGroupFragment"
        android:name="com.example.triponai.ui.plan.TravelGroupFragment"
        android:label="Travel Group"
        tools:layout="@layout/fragment_travel_group">
        <action
            android:id="@+id/action_travelGroupFragment_to_tripDetailsFragment"
            app:destination="@id/tripDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/tripDetailsFragment"
        android:name="com.example.triponai.ui.plan.TripDetailsFragment"
        android:label="Trip Details"
        tools:layout="@layout/fragment_trip_details">
        <action
            android:id="@+id/action_tripDetailsFragment_to_finishTripPlanFragment"
            app:destination="@id/finishTripPlanFragment" />
    </fragment>

    <fragment
        android:id="@+id/finishTripPlanFragment"
        android:name="com.example.triponai.ui.plan.FinishTripPlanFragment"
        android:label="Finish Trip Plan"
        tools:layout="@layout/fragment_finish_trip_plan">
        <action
            android:id="@+id/action_finishTripPlanFragment_to_aiGeneratingFragment"
            app:destination="@id/aiGeneratingFragment" />
    </fragment>

    <fragment
        android:id="@+id/aiGeneratingFragment"
        android:name="com.example.triponai.ui.plan.AIGeneratingFragment"
        android:label="AI Generating"
        tools:layout="@layout/fragment_ai_generating">
        <action
            android:id="@+id/action_aiGeneratingFragment_to_aiTripPlanFragment"
            app:destination="@id/aiTripPlanFragment"
            app:popUpTo="@id/aiGeneratingFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <fragment
        android:id="@+id/aiTripPlanFragment"
        android:name="com.example.triponai.ui.plan.AITripPlanFragment"
        android:label="AI Trip Plan"
        tools:layout="@layout/fragment_ai_trip_plan">
        <action
            android:id="@+id/action_aiTripPlanFragment_to_hotelSuggestionsFragment"
            app:destination="@id/hotelSuggestionsFragment" />
    </fragment>

    <fragment
        android:id="@+id/hotelSuggestionsFragment"
        android:name="com.example.triponai.ui.plan.HotelSuggestionsFragment"
        android:label="Hotel Suggestions"
        tools:layout="@layout/fragment_hotel_suggestions">
        <action
            android:id="@+id/action_hotelSuggestionsFragment_to_attractionRecommendationsFragment"
            app:destination="@id/attractionRecommendationsFragment" />
    </fragment>

    <fragment
        android:id="@+id/attractionRecommendationsFragment"
        android:name="com.example.triponai.ui.plan.AttractionRecommendationsFragment"
        android:label="Attractions"
        tools:layout="@layout/fragment_attraction_recommendations">
        <action
            android:id="@+id/action_attractionRecommendationsFragment_to_budgetBreakdownFragment"
            app:destination="@id/budgetBreakdownFragment" />
    </fragment>

    <fragment
        android:id="@+id/budgetBreakdownFragment"
        android:name="com.example.triponai.ui.plan.BudgetBreakdownFragment"
        android:label="Budget Breakdown"
        tools:layout="@layout/fragment_budget_breakdown">
        <action
            android:id="@+id/action_budgetBreakdownFragment_to_packingChecklistFragment"
            app:destination="@id/packingChecklistFragment" />
    </fragment>

    <fragment
        android:id="@+id/packingChecklistFragment"
        android:name="com.example.triponai.ui.plan.PackingChecklistFragment"
        android:label="Packing Checklist"
        tools:layout="@layout/fragment_packing_checklist" />

    <fragment
        android:id="@+id/myTripsFragment"
        android:name="com.example.triponai.ui.home.MyTripsFragment"
        android:label="My Trips"
        tools:layout="@layout/fragment_my_trips">
        <action
            android:id="@+id/action_myTripsFragment_to_previousTripDetailFragment"
            app:destination="@id/previousTripDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/previousTripDetailFragment"
        android:name="com.example.triponai.ui.home.PreviousTripDetailFragment"
        android:label="Previous Trip Detail"
        tools:layout="@layout/fragment_previous_trip_detail">
        <argument
            android:name="tripId"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/profileFragment"
        android:name="com.example.triponai.ui.profile.ProfileFragment"
        android:label="Profile"
        tools:layout="@layout/fragment_profile">
        <action
            android:id="@+id/action_profileFragment_to_profileDetailsFragment"
            app:destination="@id/profileDetailsFragment" />
    </fragment>

    <fragment
        android:id="@+id/profileDetailsFragment"
        android:name="com.example.triponai.ui.profile.ProfileDetailsFragment"
        android:label="Profile Details"
        tools:layout="@layout/fragment_profile_details" />

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.example.triponai.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />

    <action
        android:id="@+id/action_global_loginFragment"
        app:destination="@id/loginFragment"
        app:popUpTo="@id/nav_graph"
        app:popUpToInclusive="true" />

</navigation>
